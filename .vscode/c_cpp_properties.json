{
    "configurations": [
        {
            "name": "x64",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/vendor/JUCE/modules",
                "${workspaceFolder}/build-local/MyAmpSim_artefacts/JuceLibraryCode"
            ],
            "defines": [
                "JUCE_GLOBAL_MODULE_SETTINGS_INCLUDED=1",
                "JUCE_WEB_BROWSER=0",
